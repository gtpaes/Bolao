# Copie para .env e preencha. NUNCA commite o .env com valores reais.
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# MongoDB Atlas (string de conexão completa)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/bolao?retryWrites=true&w=majority

# Auth
JWT_SECRET=troque-por-um-segredo-longo-aleatorio
JWT_EXPIRATION=8h

# API-Futebol (https://dash.api-futebol.com.br)
FOOTBALL_API_BASE_URL=https://api.api-futebol.com.br/v1
FOOTBALL_API_KEY=
FOOTBALL_CAMPEONATO_ID=10
FOOTBALL_ROUND_POLL_MINUTES=30
FOOTBALL_LIVE_POLL_SECONDS=30
FOOTBALL_MATCH_DURATION_MINUTES=130
FOOTBALL_TIMEOUT_MS=10000

# Mercado Pago (Pix)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=true

# Jobs automaticos (sync da rodada, ao-vivo, fechamento).
# Local: false (o Render fica responsavel). Render: true.
ENABLE_SCHEDULERS=true
